# Library Portal — environment example. Copy to .env and fill in.
# NEVER commit .env. All settings use the LIBRARY_ prefix.

# --- Core ---
LIBRARY_APP_ENV=development            # development | test | test-vps | production
LIBRARY_HOST=127.0.0.1
LIBRARY_PORT=8001
LIBRARY_LOG_LEVEL=INFO

# --- Database (dev: compose.dev.yaml publishes 127.0.0.1:55440) ---
LIBRARY_DATABASE_URL=postgresql+asyncpg://library:library@127.0.0.1:55440/library
LIBRARY_DB_ECHO=false

# --- Storage (content-addressed; gitignored) ---
LIBRARY_STORAGE_ROOT=./storage

# --- Import (master prompt 6) ---
# Explicitly allowed local roots, comma-separated; never scanned beyond these
# LIBRARY_IMPORT_ROOTS=/home/roman/books/inbox,/mnt/cloud/books
LIBRARY_MAX_FILE_MB=50
LIBRARY_MAX_FILES_PER_BATCH=20

# --- Auth (macroportal-level, ADR-0006) ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LIBRARY_JWT_SECRET=CHANGE-ME-generate-a-long-random-secret
LIBRARY_JWT_ALGORITHM=HS256
LIBRARY_ACCESS_TOKEN_TTL_MINUTES=15
LIBRARY_REFRESH_TOKEN_TTL_DAYS=30
LIBRARY_DEVICE_TOKEN_TTL_DAYS=365
# Set false only for local http dev; production must be true
LIBRARY_COOKIE_SECURE=false

# --- Rate limits ---
LIBRARY_LOGIN_RATE_LIMIT=5
LIBRARY_REGISTER_RATE_LIMIT=3
LIBRARY_RATE_LIMIT_WINDOW_SECONDS=60

# --- Integration tests (compose.test.yaml publishes 127.0.0.1:55441) ---
# LIBRARY_TEST_DATABASE_URL=postgresql+asyncpg://library:library@127.0.0.1:55441/library_test

# --- AI via OmniRoute (Phase 4; key must not be committed) ---
# LIBRARY_AI_BASE_URL=https://llm.gorbunovr.ru/v1
# LIBRARY_AI_API_KEY=sk-...
# LIBRARY_NORMALIZER_MODEL=...
