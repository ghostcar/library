# Library Portal — environment example. Copy to .env and fill in.
# NEVER commit .env. All settings use the LIBRARY_ prefix.

# --- Core ---
LIBRARY_APP_ENV=development            # development | test | test-vps | production
LIBRARY_HOST=127.0.0.1
LIBRARY_PORT=8001
LIBRARY_LOG_LEVEL=INFO

# --- Database (dev: compose.dev.yaml publishes 127.0.0.1:55440) ---
LIBRARY_DATABASE_URL=postgresql+asyncpg://library:library@127.0.0.1:55440/library
LIBRARY_DB_ECHO=false

# --- Integration tests (compose.test.yaml publishes 127.0.0.1:55441) ---
# LIBRARY_TEST_DATABASE_URL=postgresql+asyncpg://library:library@127.0.0.1:55441/library_test

# --- AI via OmniRoute (Phase 4; key must not be committed) ---
# LIBRARY_AI_BASE_URL=https://llm.gorbunovr.ru/v1
# LIBRARY_AI_API_KEY=sk-...
# LIBRARY_NORMALIZER_MODEL=...
